# Set these in Vercel Preview first. Never commit the service-account JSON key.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"service-account@project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n..."}
RM_SNAPSHOT_SPREADSHEET_ID=google-sheet-id-containing-the-hidden-snapshot
RM_SNAPSHOT_SHEET=_API_Cutover_Snapshot
RM_SNAPSHOT_EXPECTED_COUNT=110
# Must be longer than the snapshot generator period plus slack. A daily job
# needs about 90000. The current 7200 only works if the snapshot is refreshed
# at least every two hours, which it is not.
RM_SNAPSHOT_MAX_AGE_SECONDS=7200
# The API reads only columns B, D, and G from this index: student_name,
# phone_last4, and current_status. It never reads full telephone numbers.
RM_AUTH_INDEX_SHEET=_DB_Student_Master
RM_AUTH_INDEX_COUNT=110
# Optional: keep the index in its own spreadsheet so the snapshot can be
# shared without exposing the rest of the workbook. Defaults to the snapshot id.
# RM_AUTH_INDEX_SPREADSHEET_ID=google-sheet-id-for-the-student-index
